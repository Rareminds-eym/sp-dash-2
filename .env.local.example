# ============================================================
# LOCAL DEVELOPMENT SETUP EXAMPLE
# ============================================================
# Copy this file to .env.local for local development
# Values below are for local Docker Supabase instances
#
# Command: cp .local.example .env.local
#
# NOTE: These demo keys should NEVER be used in production!
# ============================================================

# ============================================================
# SSO WORKER - Running locally on port 8787
# ============================================================
SSO_WORKER_URL=http://127.0.0.1:8787

# ============================================================
# SSO AUTH DATABASE
# ============================================================
# Docker container: supabase_db_sso-auth (port 54332)
# Supabase REST API runs on port 54331
SSO_AUTH_SUPABASE_URL=http://127.0.0.1:54331
SSO_AUTH_SUPABASE_ANON_KEY=your_sso_auth_supabase_anon_key_here
SSO_AUTH_SERVICE_ROLE_KEY=your_sso_auth_service_role_key_here

# ============================================================
# SKILLPASSPORT DATABASE
# ============================================================
# Docker container: supabase_db_skillpassport (port 54322)
# Supabase REST API runs on port 54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_skillpassport_supabase_anon_key_here

# Backend server-side access (with admin privileges)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your_skillpassport_service_role_key_here

# ============================================================
# ENVIRONMENT
# ============================================================
NODE_ENV=development

# ============================================================
# DOCKER CONTAINER REFERENCES
# ============================================================
# To connect to databases locally:
#
# SkillPassport Database:
#   docker exec -it supabase_db_skillpassport psql -U postgres -d postgres
#
# SSO Auth Database:
#   docker exec -it supabase_db_sso-auth psql -U postgres -d postgres
#
# Check running containers:
#   docker ps | grep postgres
# ============================================================
 