NEXT_PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=*

# ============================================================
# SSO WORKER - Authentication Service
# ============================================================
# Local development - SSO worker running on port 8787
SSO_WORKER_URL=http://127.0.0.1:8787
# For production, use your deployed SSO worker URL
# SSO_WORKER_URL=https://your-sso-worker.workers.dev

# JWT Configuration for verification
SSO_JWT_ISSUER=http://localhost:8787
SSO_JWT_AUDIENCE=sp-dash-2

# ============================================================
# SSO AUTH DATABASE - Authentication Data (users, sessions)
# ============================================================
# Supabase API for SSO database (port 54331 = REST API)
# Docker container DB port: 54332 (PostgreSQL)
# NOTE: These are Supabase demo keys for local development ONLY
# Do NOT use in production. Generate real keys in Cloudflare dashboard.
SSO_AUTH_SUPABASE_URL=http://127.0.0.1:54331
SSO_AUTH_SUPABASE_ANON_KEY=your_sso_auth_supabase_anon_key_here
SSO_AUTH_SERVICE_ROLE_KEY=your_sso_auth_service_role_key_here

# ============================================================
# SKILLPASSPORT DATABASE - Application Data (courses, passports, assessments)
# ============================================================
# LOCAL DEVELOPMENT - Connect to local SkillPassport Supabase
# Docker container: supabase_db_skillpassport (port 54322)
# NOTE: These are Supabase demo keys for local development ONLY
# Do NOT use in production. Generate real keys in Cloudflare dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_skillpassport_supabase_anon_key_here

# Backend Supabase client (for API routes)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_skillpassport_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_skillpassport_service_role_key_here

# ============================================================
# DATABASE CONNECTIONS
# ============================================================
# SkillPassport PostgreSQL (Docker: supabase_db_skillpassport)
SKILLPASSPORT_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SKILLPASSPORT_DB_HOST=127.0.0.1
SKILLPASSPORT_DB_PORT=54322
SKILLPASSPORT_DB_NAME=postgres
SKILLPASSPORT_DB_USER=postgres
SKILLPASSPORT_DB_PASSWORD=postgres

# SSO PostgreSQL (Docker: supabase_db_sso-auth)
SSO_DB_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres
SSO_DB_HOST=127.0.0.1
SSO_DB_PORT=54332
SSO_DB_NAME=postgres
SSO_DB_USER=postgres
SSO_DB_PASSWORD=postgres

# ============================================================
# ENVIRONMENT
# ============================================================
NODE_ENV=development
NEXT_ENV=development
