# ============================================================
# REQUIRED: Set these in .env.local for local development
# ============================================================

# ============================================================
# SSO WORKER - Authentication Service
# ============================================================
# URL of the SSO worker (local dev: http://127.0.0.1:8787)
# Production: https://your-sso-worker.workers.dev
SSO_WORKER_URL=http://127.0.0.1:8787

# ============================================================
# SKILLPASSPORT DATABASE - Application Data
# ============================================================
# Main Supabase instance for courses, passports, assessments
# Local dev uses Supabase demo keys (see .env.local)
# Production: Use real Cloudflare secrets
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend admin operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================
# CLOUDFLARE R2 - LTE course assets
# ============================================================
# Public HTTPS custom domain; no trailing slash required.
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://assets.example.com
# Operator/server-only values for Wrangler or S3-compatible local tooling.
CLOUDFLARE_API_TOKEN=your_scoped_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# ============================================================
# ENVIRONMENT
# ============================================================
NODE_ENV=development
