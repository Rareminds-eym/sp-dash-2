# Copy to .env.local for Next.js public build values and the existing
# SkillPassport server configuration. LTE Worker settings use .dev.vars.

# ============================================================
# SSO WORKER - Authentication Service
# ============================================================
# URL of the SSO worker (local dev: http://127.0.0.1:8787)
# Production: https://your-sso-worker.workers.dev
SSO_WORKER_URL=http://127.0.0.1:8787

# ============================================================
# SKILLPASSPORT DATABASE - Application Data
# ============================================================
# Main Supabase instance for courses, passports, assessments
# Local dev uses Supabase demo keys.
# Production: Use real Cloudflare secrets
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend admin operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
