    "test:sql:timeout": "bash tests/sql/run-tests.sh --with-timeout",
    "test:sql:direct": "psql \"$LTE_TEST_DATABASE_URL\" -v ON_ERROR_STOP=1 -f tests/sql/publish_lte_catalog_snapshot_v2_1.test.sql"
