  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:pages": "npm run build:cf && npx wrangler pages dev .vercel/output/static --port 3000 --compatibility-flags nodejs_compat",
    "pages:dev": "npx wrangler pages dev .vercel/output/static --port 8789 --compatibility-flags nodejs_compat",
    "build": "next build",
    "build:cf": "npx @cloudflare/next-on-pages",
