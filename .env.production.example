# ============================================================
# SSO WORKER - Authentication Service
# ============================================================
SSO_WORKER_URL=https://sso-api.your-domain.workers.dev

# ============================================================
# SKILLPASSPORT DATABASE - Application Data
# ============================================================
# This is the main database for courses, passports, assessments, etc.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend admin operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================
# CLOUDFLARE R2 - LTE course assets
# ============================================================
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://assets.your-domain.example
# Configure these as encrypted deployment/operator secrets, never public vars.
CLOUDFLARE_API_TOKEN=your_scoped_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
